include protocol PCompositorBridge;
include "mozilla/GfxMessageUtils.h";
using mozilla::LayoutDeviceIntSize from "Units.h";

// Portable headless notifications only. This does not enable a GPU process
// or certify out-of-process composition; Orbis currently presents in-process.
namespace mozilla {
namespace widget {

[ChildImpl=virtual, ParentImpl=virtual]
sync protocol PCompositorWidget
{
  manager PCompositorBridge;

parent:
  async __delete__();
  async NotifyClientSizeChanged(LayoutDeviceIntSize aClientSize);

child:
  async ObserveVsync();
  async UnobserveVsync();
};

} // namespace widget
} // namespace mozilla
